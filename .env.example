# Configuración general
APP_ENV=production
LOG_LEVEL=INFO

# Base de datos
DB_PATH=./data/compra_agil.db

# Directorios
DOWNLOADS_DIR=./data/downloads
LOGS_DIR=./logs

# Scraper
SCRAPER_BASE_URL=https://datos-abiertos.chilecompra.cl/descargas/compra-agil
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT_MS=60000
SCRAPER_DOWNLOAD_WAIT_S=30

# Scheduler (cada 2 horas)
SCHEDULER_INTERVAL_HOURS=2

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# Paginación por defecto
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
