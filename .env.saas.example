# ============================================================
# CompraÁgil SaaS — Variables de entorno
# Copiar a .env y completar los valores reales
# ============================================================

APP_ENV=production
LOG_LEVEL=INFO
FRONTEND_URL=https://mp.heforge.cl

# ---- PostgreSQL ----
DB_HOST=postgres          # nombre del servicio docker (o 127.0.0.1 si corre nativo)
DB_PORT=5432
DB_USER=saas_mp
DB_PASSWORD=SaasMP2025!SecurePass
DB_NAME=mp_saas

# ---- JWT ----
# Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_256BIT
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- Mercado Público API ----
MP_TICKET=B62A4372-14A4-4C86-8B06-FFF908CE0FBD
MP_REGIONS_DEFAULT=10,11,9

# ---- Telegram Bot (para notificaciones a usuarios) ----
TELEGRAM_BOT_TOKEN=BOT_TOKEN_DEL_BOTFATHER

# ---- API admin ----
API_SECRET_KEY=mercadopublcio2025

# ---- Scheduler ----
SCHEDULER_INTERVAL_HOURS=2
